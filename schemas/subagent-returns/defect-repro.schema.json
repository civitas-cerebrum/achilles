{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civitas-cerebrum.github.io/element-interactions/schemas/subagent-returns/defect-repro.schema.json",
  "title": "Defect reproducer (achilles-reproducer) return: the standard defect evidence",
  "description": "One independent verdict on one suspected defect (skills/defect-confirmation/SKILL.md; verify-change phase 7a). The harness records it as the defect confirmation that sign-off and defect filing require.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "handover",
    "ticket",
    "defect-id",
    "verdict",
    "reproduction",
    "root-cause",
    "severity",
    "steps",
    "cleanup"
  ],
  "properties": {
    "handover": {
      "allOf": [
        {
          "$ref": "handover.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "verdict-reached",
                "blocked"
              ]
            }
          }
        }
      ]
    },
    "ticket": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,}$",
      "description": "The ticket key under test."
    },
    "defect-id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*-D[0-9]+$",
      "description": "<TICKET>-D<n>; the sentinel, the audit and a filed ticket cite it."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "bug",
        "real-in-source",
        "spec-ambiguity",
        "not-a-bug"
      ]
    },
    "surface": {
      "type": "string",
      "enum": [
        "ui",
        "api",
        "backend",
        "data"
      ],
      "description": "Where the defect shows: ui when a user sees it in the application, otherwise the layer the evidence comes from."
    },
    "reproduction": {
      "type": "object",
      "required": [
        "attempts",
        "observed"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "varied": {
          "type": "string",
          "description": "What differed between attempts when the defect is non-deterministic."
        }
      }
    },
    "root-cause": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layer",
          "location"
        ],
        "properties": {
          "layer": {
            "type": "string",
            "description": "frontend, backend, data, ..."
          },
          "location": {
            "type": "string",
            "description": "file:line, or why the source for this layer was not available"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    },
    "severity": {
      "type": "object",
      "required": [
        "level",
        "reason"
      ],
      "properties": {
        "level": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "One action per step, for a reader with no context; no shorthand."
    },
    "expected": {
      "type": "string"
    },
    "actual": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Paths of what the reproducer captured (screenshots, network responses, downloaded files)."
    },
    "video": {
      "type": "string",
      "pattern": "\\.(webm|mp4)$",
      "description": "The reproduction recording (required for a ui bug): one action per chapter, captions naming each step."
    },
    "question": {
      "type": "string",
      "description": "For spec-ambiguity: the decision the product owner has to make."
    },
    "cleanup": {
      "type": "object",
      "required": [
        "created",
        "deleted"
      ],
      "properties": {
        "created": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deleted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budget-spent": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "blocked-reason": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "const": "bug"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "reproduction",
          "expected",
          "actual",
          "evidence",
          "surface"
        ],
        "properties": {
          "reproduction": {
            "type": "object",
            "properties": {
              "observed": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          },
          "surface": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "verdict",
          "surface"
        ],
        "properties": {
          "verdict": {
            "const": "bug"
          },
          "surface": {
            "const": "ui"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "video"
        ],
        "properties": {
          "video": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "verdict"
        ],
        "properties": {
          "verdict": {
            "const": "spec-ambiguity"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "handover": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "blocked"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "blocked-reason"
        ],
        "properties": {
          "blocked-reason": {
            "type": "string"
          }
        }
      }
    }
  ]
}
