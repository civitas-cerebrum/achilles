{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civitas-cerebrum.github.io/element-interactions/schemas/subagent-returns/platform-reviewer.schema.json",
  "title": "Platform-reviewer return",
  "description": "Return shape of the reviewer role when it reviews a platform-testing pipeline phase (handover role platform-reviewer-phase<N>, N = 1-7: preflight, scaffold, inspect, selectors, compose, review, report). The verdict is recorded in tests/platform/docs/platform-onboarding-status.json. Gates the next transition: on approve, the orchestrator advances; on reject (cap 3), the orchestrator surgically fixes per findings + re-dispatches the same reviewer; on the 3rd consecutive reject the reviewer returns escalated-to-user and the run pauses for human triage.",
  "type": "object",
  "additionalProperties": true,
  "required": ["handover", "verdict", "phase"],
  "properties": {
    "handover": {
      "allOf": [
        { "$ref": "handover.schema.json" },
        {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "pattern": "^platform-reviewer-phase[1-7]$"
            },
            "status": {
              "enum": ["approved", "rejected", "escalated-to-user"]
            }
          }
        }
      ]
    },
    "verdict": {
      "type": "string",
      "enum": ["approve", "reject", "escalate"]
    },
    "phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "Platform pipeline phase being reviewed: 1=preflight, 2=scaffold, 3=inspect, 4=selectors, 5=compose, 6=review, 7=report. Matches the N of handover.role."
    },
    "checklist": {
      "type": "array",
      "description": "Per-item pass/fail of the platform phase exit criteria. An item that checks one row of the platform discipline (skills/platform-testing/SKILL.md ## Platform discipline: app state and reset, permissions, keyboard, gestures, orientation, real versus virtual device, ...) names that row in discipline-row.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["item", "satisfied"],
        "properties": {
          "item": { "type": "string" },
          "satisfied": { "type": "boolean" },
          "evidence": { "type": "string" },
          "methodology-ref": { "type": "string" },
          "discipline-row": { "type": "string", "minLength": 1, "description": "The platform-discipline row this item ticks: the text of one ### heading under ## Platform discipline in skills/platform-testing/SKILL.md, e.g. 'Permissions and system alerts'." }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Surgical fix list. Required when verdict == 'reject' or 'escalate'. Empty when verdict == 'approve'.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["checklist-item", "what-missing", "fix-instruction"],
        "properties": {
          "checklist-item": { "type": "string" },
          "what-missing": { "type": "string" },
          "methodology-ref": { "type": "string" },
          "fix-instruction": { "type": "string" }
        }
      }
    },
    "attestation": {
      "type": "string",
      "description": "One-line summary of what was verified. Required when verdict == 'approve'."
    },
    "authorizer": {
      "type": "string",
      "description": "Required when the reviewer approves a skip / early-stop transition. Must carry either a verbatim user quote OR a documented structural exception."
    },
    "reviewerCycle": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "Which review dispatch this is for the phase. The orchestrator increments per reject; the 3rd consecutive reject escalates."
    },
    "summary": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "verdict": { "const": "approve" } }
      },
      "then": {
        "type": "object",
        "required": ["attestation"],
        "properties": {
          "attestation": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "verdict": { "const": "reject" } }
      },
      "then": {
        "type": "object",
        "required": ["findings"],
        "properties": {
          "findings": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": { "verdict": { "const": "escalate" } }
      },
      "then": {
        "type": "object",
        "required": ["findings"],
        "properties": {
          "findings": { "type": "array", "minItems": 1 }
        }
      }
    },
    {"if": {"type": "object", "required": ["handover"], "properties": {"handover": {"type": "object", "required": ["role"], "properties": {"role": {"const": "platform-reviewer-phase1"}}}}}, "then": {"type": "object", "required": ["phase"], "properties": {"phase": {"const": 1}}}},
    {"if": {"type": "object", "required": ["handover"], "properties": {"handover": {"type": "object", "required": ["role"], "properties": {"role": {"const": "platform-reviewer-phase2"}}}}}, "then": {"type": "object", "required": ["phase"], "properties": {"phase": {"const": 2}}}},
    {"if": {"type": "object", "required": ["handover"], "properties": {"handover": {"type": "object", "required": ["role"], "properties": {"role": {"const": "platform-reviewer-phase3"}}}}}, "then": {"type": "object", "required": ["phase"], "properties": {"phase": {"const": 3}}}},
    {"if": {"type": "object", "required": ["handover"], "properties": {"handover": {"type": "object", "required": ["role"], "properties": {"role": {"const": "platform-reviewer-phase4"}}}}}, "then": {"type": "object", "required": ["phase"], "properties": {"phase": {"const": 4}}}},
    {"if": {"type": "object", "required": ["handover"], "properties": {"handover": {"type": "object", "required": ["role"], "properties": {"role": {"const": "platform-reviewer-phase5"}}}}}, "then": {"type": "object", "required": ["phase"], "properties": {"phase": {"const": 5}}}},
    {"if": {"type": "object", "required": ["handover"], "properties": {"handover": {"type": "object", "required": ["role"], "properties": {"role": {"const": "platform-reviewer-phase6"}}}}}, "then": {"type": "object", "required": ["phase"], "properties": {"phase": {"const": 6}}}},
    {"if": {"type": "object", "required": ["handover"], "properties": {"handover": {"type": "object", "required": ["role"], "properties": {"role": {"const": "platform-reviewer-phase7"}}}}}, "then": {"type": "object", "required": ["phase"], "properties": {"phase": {"const": 7}}}},
    {"if": {"type": "object", "required": ["verdict"], "properties": {"verdict": {"const": "approve"}}}, "then": {"type": "object", "required": ["handover"], "properties": {"handover": {"type": "object", "required": ["status"], "properties": {"status": {"const": "approved"}}}}}},
    {"if": {"type": "object", "required": ["verdict"], "properties": {"verdict": {"const": "reject"}}}, "then": {"type": "object", "required": ["handover"], "properties": {"handover": {"type": "object", "required": ["status"], "properties": {"status": {"const": "rejected"}}}}}},
    {"if": {"type": "object", "required": ["verdict"], "properties": {"verdict": {"const": "escalate"}}}, "then": {"type": "object", "required": ["handover"], "properties": {"handover": {"type": "object", "required": ["status"], "properties": {"status": {"const": "escalated-to-user"}}}}}}
  ]
}
