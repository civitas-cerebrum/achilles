{
  "kind": "kernel-mandate-bundle",
  "bundleVersion": 1,
  "metadata": {
    "name": "qa-pipeline",
    "revision": "1.0.0",
    "title": "QA Pipeline OS",
    "description": "Orchestrator dispatches; inspector inspects; composer builds; reviewer reads criteria + deliverable; judge alone updates the ledger.",
    "author": "Umut Ay Bora",
    "createdAt": "2026-08-22T10:00:00Z",
    "basedOn": "qa-pipeline",
    "tags": [
      "qa",
      "playwright",
      "separation-of-duties"
    ]
  },
  "manifest": {
    "kernelMandateVersion": 1,
    "name": "qa-pipeline",
    "description": "Reference QA harness: orchestrator dispatches, inspector inspects, implementer builds, reviewer reads criteria + deliverable, judge alone updates the ledger.",
    "settings": {
      "mainSessionRole": "orchestrator",
      "unboundAgentPolicy": "readonly",
      "dispatchTtlSeconds": 1800
    },
    "commandGroups": {
      "inspection": [
        "^git (status|log|diff|show|blame)\\b",
        "^(ls|find|wc|file|stat|du)\\b",
        "^(cat|head|tail|sort|uniq|cut|tr|grep|rg|jq)\\b"
      ],
      "test-execution": [
        "^(npx|yarn|pnpm exec) playwright\\b",
        "^npm (test|run test[a-z:-]*)\\b"
      ]
    },
    "roles": {
      "orchestrator": {
        "description": "Dispatches the appropriate agents to the tasks of a workflow. Never does the work itself.",
        "tools": {
          "allow": [
            "Agent",
            "Read",
            "Glob",
            "Grep",
            "TaskCreate",
            "TaskUpdate",
            "TaskList",
            "TaskGet"
          ]
        },
        "read": {
          "allow": [
            "docs/ledger.json",
            "workflows/**"
          ]
        },
        "dispatch": [
          "inspector",
          "implementer",
          "reviewer",
          "judge"
        ]
      },
      "inspector": {
        "description": "Runs inspection commands and reads files relevant to its task.",
        "tools": {
          "allow": [
            "Bash",
            "Read",
            "Glob",
            "Grep"
          ]
        },
        "bash": {
          "groups": [
            "inspection"
          ]
        },
        "read": {
          "allow": [
            "src/**",
            "tests/**",
            "docs/**"
          ]
        }
      },
      "implementer": {
        "description": "Writes the deliverable inside the source and test trees.",
        "tools": {
          "allow": [
            "Bash",
            "Read",
            "Glob",
            "Grep",
            "Write",
            "Edit"
          ]
        },
        "bash": {
          "groups": [
            "inspection",
            "test-execution"
          ]
        },
        "read": {
          "allow": [
            "src/**",
            "tests/**",
            "docs/acceptance/**",
            "package.json"
          ]
        },
        "write": {
          "allow": [
            "src/**",
            "tests/**"
          ]
        }
      },
      "reviewer": {
        "description": "Reads acceptance criteria and the deliverable. Nothing else.",
        "tools": {
          "allow": [
            "Read",
            "Glob",
            "Grep"
          ]
        },
        "read": {
          "allow": [
            "docs/acceptance/**",
            "src/**",
            "tests/**"
          ]
        }
      },
      "judge": {
        "description": "The only role permitted to update the ledger.",
        "tools": {
          "allow": [
            "Read",
            "Write",
            "Edit"
          ]
        },
        "read": {
          "allow": [
            "docs/**"
          ]
        },
        "write": {
          "allow": [
            "docs/ledger.json"
          ]
        }
      }
    }
  },
  "fingerprint": "sha256:99179216852154466b0a9adb724f929b3b536b70267c060a54ec52076d409ebd",
  "notes": "Initial revision of the canonical QA harness."
}
