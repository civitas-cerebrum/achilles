{
  "$comment": "Hand-curated input of scripts/build-equivalents.mjs. methods: raw Playwright method -> the Steps methods that replace it (any one present in a release counts); `on` limits an entry to receiver kinds. http: request-binding methods -> the browser-session Steps method (the strict reading). evaluate: the page-scripting methods that have a Steps equivalent. noEquivalent: the TB-A2b table, each entry with its register row (null when no seed row covers it). The build adds, per target, the first published release that has it.",
  "package": "@civitas-cerebrum/element-interactions",
  "methods": {
    "goto": { "targets": ["navigateTo"] },
    "reload": { "targets": ["refresh"] },
    "goBack": { "targets": ["backOrForward"] },
    "goForward": { "targets": ["backOrForward"] },
    "setViewportSize": { "targets": ["setViewport"] },
    "waitForURL": { "targets": ["waitForUrl"] },
    "waitForSelector": { "targets": ["waitForState"] },
    "waitFor": { "targets": ["waitForState"] },
    "waitForLoadState": { "targets": ["waitForLoadState"] },
    "waitForResponse": { "targets": ["waitForResponse"] },
    "waitForEvent": { "targets": ["switchToNewTab"], "args": ["popup", "page"] },
    "click": { "targets": ["click"] },
    "fill": { "targets": ["fill"] },
    "type": { "targets": ["typeSequentially"], "on": ["page", "frame", "locator"] },
    "pressSequentially": { "targets": ["typeSequentially"] },
    "press": { "targets": ["pressKey"] },
    "check": { "targets": ["check"] },
    "uncheck": { "targets": ["uncheck"] },
    "selectOption": { "targets": ["selectDropdown"] },
    "hover": { "targets": ["hover"] },
    "dblclick": { "targets": ["doubleClick"] },
    "setInputFiles": { "targets": ["uploadFile"] },
    "dragTo": { "targets": ["dragAndDrop"] },
    "clear": { "targets": ["clearInput"] },
    "dispatchEvent": { "targets": ["dispatchEvent"] },
    "scrollIntoViewIfNeeded": { "targets": ["scrollIntoView"] },
    "textContent": { "targets": ["getText"] },
    "innerText": { "targets": ["getText", "getPageText"] },
    "inputValue": { "targets": ["getInputValue"] },
    "getAttribute": { "targets": ["getAttribute"] },
    "count": { "targets": ["getCount"] },
    "isVisible": { "targets": ["isVisible", "isPresent"] },
    "allTextContents": { "targets": ["getAll"] },
    "allInnerTexts": { "targets": ["getAll"] },
    "boundingBox": { "targets": ["getBoundingBox"] },
    "url": { "targets": ["getUrl"] },
    "title": { "targets": ["verifyPageTitle"] },
    "content": { "targets": ["getPageHtml"] },
    "screenshot": { "targets": ["screenshot"] },
    "close": { "targets": ["closeTab"], "on": ["page"] }
  },
  "http": {
    "get": { "targets": ["requestGet"] },
    "post": { "targets": ["requestPost"] },
    "put": { "targets": ["requestPut"] },
    "patch": { "targets": ["requestPatch"] },
    "delete": { "targets": ["requestDelete"] },
    "head": { "targets": ["requestHead"] }
  },
  "evaluate": {
    "methods": ["evaluate", "evaluateHandle", "$eval", "$$eval"],
    "targets": ["evaluateScript", "getWindowProperty", "getLocalStorage"]
  },
  "noEquivalent": [
    { "on": ["context"], "methods": ["cookies", "addCookies", "clearCookies"], "row": "FG-1" },
    { "on": ["page", "context"], "methods": ["route", "unroute", "unrouteAll"], "row": "FG-2" },
    { "on": ["page", "context"], "methods": ["on"], "args": ["console", "pageerror", "request"], "row": "FG-3" },
    { "on": ["locator"], "methods": ["focus"], "row": "FG-4" },
    { "on": ["page", "context"], "methods": ["on"], "args": ["dialog"], "row": "FG-5" },
    { "on": ["browser"], "methods": ["newContext", "newPage", "close"], "row": "FG-6" },
    { "on": ["context"], "methods": ["newPage", "close"], "row": "FG-6" },
    { "on": ["page", "frame", "context"], "methods": ["waitForEvent"], "args": ["download", "filechooser"], "row": null },
    { "on": ["request"], "methods": ["dispose"], "row": null },
    { "on": ["page", "context"], "methods": ["addStyleTag", "addInitScript"], "mutationHook": true, "row": null },
    { "on": ["page", "context", "browser"], "methods": ["on", "once", "off", "removeListener", "addListener", "removeAllListeners"], "row": null },
    { "on": ["context", "request"], "methods": ["storageState"], "row": null },
    { "on": ["context"], "methods": ["grantPermissions", "clearPermissions", "setOffline", "setGeolocation", "pages"], "row": null },
    { "on": ["page", "context"], "methods": ["setExtraHTTPHeaders"], "row": null },
    { "on": ["page"], "methods": ["isClosed", "bringToFront", "video"], "row": null },
    { "on": ["browser"], "methods": ["contexts", "isConnected", "version"], "row": null }
  ]
}
