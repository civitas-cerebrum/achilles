{
  "name": "@civitas-cerebrum/achilles",
  "version": "0.3.0",
  "description": "Autonomous quality-assurance methodology: harness-neutral agent skills and agent definitions, return-shape schemas and a Playwright reporter, with a Claude Code plugin adapter (delegate_qa, /achilles, the orchestrator and its experts).",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test:lint": "node scripts/lint-doc-drift.mjs",
    "test:bin": "node --test tests/bin/*.test.mjs tests/install/*.test.mjs",
    "test:reporter": "node --test --test-concurrency=1 reporter/tests/*.test.mjs",
    "test:adapter": "node --test claude-code/tests/lib/*/*.test.js && node scripts/claude-plugin.mjs validate . --strict && node scripts/claude-plugin.mjs test .",
    "schemas:lint": "node scripts/compile-schemas.mjs && node scripts/validate-schema-fixtures.mjs",
    "test": "node scripts/run-suites.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepack": "npm run check:pack && npm test"
  },
  "bin": {
    "achilles-self-repair": "bin/self-repair.mjs",
    "achilles-show": "bin/show.mjs",
    "achilles-mutate": "bin/mutate.mjs",
    "achilles-scenario-lint": "bin/scenario-lint.mjs",
    "achilles-selector-evidence": "bin/selector-evidence.mjs"
  },
  "exports": {
    "./reporter": "./reporter/index.js",
    "./package.json": "./package.json",
    "./bin/*": "./bin/*",
    "./skills/*": "./skills/*",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "bin",
    "skills",
    "agents",
    "schemas",
    "reporter",
    "claude-code",
    ".claude-plugin",
    "scripts/postinstall.js",
    "scripts/install/chromium.js"
  ],
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "@civitas-cerebrum/element-interactions": ">=0.3.8 <1.0.0",
    "@playwright/cli": "0.1.17",
    "@playwright/test": "^1.62.0",
    "@vue/compiler-sfc": "^3.5.34",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "parse5": "^7.3.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "svelte": "^5.55.9",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "keywords": [
    "playwright",
    "automation",
    "qa",
    "claude-code",
    "claude-code-plugin",
    "pi-package",
    "agent-skills",
    "agentic-testing",
    "methodology",
    "element-interactions"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civitas-cerebrum/achilles.git"
  },
  "overrides": {
    "nodemailer": "^10.2.1",
    "html-to-text": "10.0.1"
  },
  "author": "Umut Ay Bora",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
