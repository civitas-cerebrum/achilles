{
  "name": "@civitas-cerebrum/achilles",
  "version": "0.1.8",
  "description": "Autonomous quality-assurance methodology — agent skills, harness hooks, return-shape schemas, and post-install plumbing that drive the @civitas-cerebrum/element-interactions framework end-to-end.",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "build:validator": "node scripts/build-validator.mjs",
    "test:hooks": "npm run build:validator && hooks/tests/run.sh",
    "test:reporter": "node --test --test-concurrency=1 \"reporter/tests/*.test.mjs\"",
    "sync-hooks": "node scripts/sync-hooks.js",
    "sync:kernel-mandate": "node scripts/sync-kernel-mandate.mjs",
    "schemas:lint": "node scripts/compile-schemas.mjs && node scripts/validate-schema-fixtures.mjs",
    "prepack": "npm run schemas:lint && node scripts/lint-doc-drift.mjs && node scripts/sync-kernel-mandate.mjs --check && npm run test:hooks && npm run test:reporter"
  },
  "bin": {
    "achilles-self-repair": "bin/self-repair.mjs",
    "achilles-show": "bin/show.mjs",
    "achilles-mutate": "bin/mutate.mjs"
  },
  "exports": {
    "./reporter": "./reporter/index.js",
    "./package.json": "./package.json",
    "./bin/*": "./bin/*",
    "./hooks/*": "./hooks/*",
    "./skills/*": "./skills/*",
    "./schemas/*": "./schemas/*",
    "./scripts/postinstall.js": "./scripts/postinstall.js"
  },
  "files": [
    "bin",
    "hooks",
    "skills",
    "schemas",
    "reporter",
    "scripts/postinstall.js"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "@civitas-cerebrum/element-interactions": ">=0.3.8 <1.0.0",
    "@playwright/cli": "0.1.17",
    "@playwright/test": "^1.62.0",
    "@vue/compiler-sfc": "^3.5.34",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "parse5": "^7.3.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "svelte": "^5.55.9",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "keywords": [
    "playwright",
    "automation",
    "qa",
    "claude-code",
    "agent-skills",
    "agentic-testing",
    "methodology",
    "harness-hooks",
    "element-interactions"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civitas-cerebrum/achilles.git"
  },
  "overrides": {
    "nodemailer": "^9.0.1"
  },
  "author": "Umut Ay Bora",
  "license": "MIT"
}
