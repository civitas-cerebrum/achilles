{
  "kernelMandateVersion": 1,
  "name": "achilles-qa",
  "settings": {
    "unboundAgentPolicy": "readonly",
    "roleTagCorroboration": "auto",
    "mainSessionRole": "orchestrator"
  },
  "roles": {
    "cleanup": {
      "description": "Cleanup / dedup worker for the coverage-expansion cleanup pass (`cleanup-<scope>:`): removes redundant specs under tests/e2e/** and re-runs the suite to prove the remainder is still green. Never the status ledger and never the page repository.",
      "agentTypes": [
        "cleanup"
      ],
      "tools": {
        "allow": [
          "Bash",
          "Edit",
          "Glob",
          "Grep",
          "Read",
          "Skill",
          "Write"
        ]
      },
      "read": {
        "allow": [
          "docs/**",
          "tests/**"
        ]
      },
      "write": {
        "allow": [
          "tests/e2e/**"
        ],
        "deny": [
          "tests/e2e/docs/onboarding-status.json",
          "**/page-repository*.json"
        ],
        "codeImports": [
          "@civitas-cerebrum/element-interactions",
          "@playwright/test"
        ]
      },
      "bash": {
        "groups": [
          "browser-session-runs",
          "suite-runs"
        ],
        "deny": [
          "^npx playwright-cli (close-all|kill-all)\\b"
        ]
      },
      "network": {
        "allow": [
          "localhost"
        ]
      },
      "skills": {
        "allow": [
          "achilles-protocol",
          "test-composer",
          "test-data-conventions"
        ]
      }
    },
    "companion": {
      "description": "companion-mode verification worker (`companion-<task-slug>:`): verifies one task against the live app in its own playwright-cli session and lands the evidence bundle under tests/e2e/evidence/**. Writes no suite specs, no ledger and no page repository.",
      "agentTypes": [
        "companion"
      ],
      "tools": {
        "allow": [
          "Bash",
          "Edit",
          "Glob",
          "Grep",
          "Read",
          "Skill",
          "Write"
        ]
      },
      "read": {
        "allow": [
          "docs/**",
          "tests/**"
        ]
      },
      "write": {
        "allow": [
          "tests/e2e/evidence/**",
          "tests/e2e/docs/.subagent-returns/**"
        ],
        "codeImports": [
          "@civitas-cerebrum/element-interactions",
          "@playwright/test"
        ]
      },
      "bash": {
        "groups": [
          "browser-session-runs",
          "suite-runs"
        ],
        "deny": [
          "^npx playwright-cli (close-all|kill-all)\\b"
        ]
      },
      "network": {
        "allow": [
          "localhost"
        ]
      },
      "skills": {
        "allow": [
          "achilles-protocol",
          "companion-mode",
          "test-composer",
          "test-data-conventions"
        ]
      }
    },
    "contribution-handover": {
      "description": "Pre-push handover author (`contribution-handover-<slug>:`): fills .contribution-handover.json from the contributing skill's guardrail checklist by reading this repo's own documentation and the branch diff. Writes exactly that one file.",
      "agentTypes": [
        "contribution-handover"
