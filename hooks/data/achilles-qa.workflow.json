{
  "name": "achilles-qa",
  "mainSessionRole": "orchestrator",
  "roles": {
    "orchestrator": {
      "description": "The main session driving the achilles QA pipeline: walks the app, records pipeline state under tests/** and .achilles/**, runs the suite, commits, and dispatches every subagent role. It authors no runner or resolution config \u2014 playwright.config.ts, package.json and the Phase 1-2 scaffold (fixtures, setup, page repository, app context) are written by the scaffolder role it dispatches. Never touches application source or secrets.",
      "agentTypes": [
        "orchestrator"
      ]
    },
    "scaffolder": {
      "description": "Write-only author of the Phase 1-2 scaffold: playwright.config.ts, package.json scripts, .gitignore entries, tests/e2e/playwright.setup.ts, tests/e2e/fixtures/**, tests/e2e/docs/app-context.md and tests/e2e/page-repository.json. No shell and no dispatch \u2014 the orchestrator runs `npx playwright test --list` to verify what it wrote, so the role that authors the runner's config never runs the runner.",
      "agentTypes": [
        "scaffolder"
      ]
    },
    "test-composer": {
      "description": "Authors Playwright specs under tests/e2e/** from a journey brief and self-verifies them with the runner. Reads the page repository and docs; writes nothing outside tests/e2e/**.",
      "agentTypes": [
        "test-composer"
      ],
      "codeImports": [
        "@playwright/test",
        "@civitas-cerebrum/element-interactions"
      ]
    },
    "in-flight-composer": {
      "description": "Same mandate as test-composer, for specs composed mid-pipeline (coverage-expansion passes, self-repair heals).",
      "agentTypes": [
        "in-flight-composer"
      ],
      "codeImports": [
        "@playwright/test",
        "@civitas-cerebrum/element-interactions"
      ]
    },
    "workflow-reviewer": {
      "description": "Approver: reviews a phase's deliverables against the ledger and records the verdict in tests/e2e/docs/onboarding-status.json. Reads only; no shell.",
      "agentTypes": [
        "workflow-reviewer"
      ]
    },
    "phase-validator": {
      "description": "Approver: emits the per-phase greenlight into tests/e2e/docs/onboarding-status.json after checking the phase's deliverables on disk. Reads only; no shell.",
      "agentTypes": [
        "phase-validator"
      ]
    },
    "process-validator": {
      "description": "Approver: validates that the pipeline followed the documented process and records the finding in tests/e2e/docs/onboarding-status.json. Reads only; no shell.",
      "agentTypes": [
        "process-validator"
      ]
    },
    "batch-reviewer": {
      "description": "Approver: reviews a batch of composed specs and records the batch verdict in tests/e2e/docs/onboarding-status.json. Reads only; no shell.",
      "agentTypes": [
        "batch-reviewer"
      ]
    },
    "perf-reviewer": {
      "description": "Approver for the perf pipeline: reviews tests/perf/** deliverables and records the verdict in tests/perf/docs/perf-onboarding-status.json. Reads only; no shell.",
      "agentTypes": [
        "perf-reviewer"
      ]
    },
    "selector-diff-validator": {
      "description": "Read-only validator: compares selector changes across tests/** and reports. Writes nothing; no shell.",
      "agentTypes": [
        "selector-diff-validator"
      ]
    },
    "implementer": {
      "description": "Writes one change: specs, fixtures and support code under tests/** (never the page repository, which live inspection owns) and the change report (report.md in the change's folder under docs/evidence/). Proves its own work with the test runner on its own shard, the type check and the unit runner. Never reviews or verifies its own change and dispatches nothing.",
      "agentTypes": [
        "implementer"
      ],
      "codeImports": [
        "@playwright/test",
        "@civitas-cerebrum/element-interactions"
      ]
    },
    "task-reviewer": {
      "description": "Approver: reads the brief, the implementer's report and the review package for one change and records findings (Critical / Important / Minor, each with file:line and a fix) in review.md in the change's folder under docs/evidence/. Writes nothing else; runs only the type check, the unit runner and the hook fixture runner; never the app.",
      "agentTypes": [
        "task-reviewer"
      ]
    },
    "verifier": {
      "description": "Approver: independently runs a change and records the verdict in verify.md in the change's folder under docs/evidence/; only it may set that note's Status: complete. Runs the test runner (a spend-incurring spec only when the brief grants the project's spend opt-in), the type check, the unit runner and the hook fixture runner. Never edits code, specs or fixtures.",
      "agentTypes": [
        "verifier"
      ]
    },
    "live-inspector": {
      "description": "Inspects the running app before any selector exists: writes throwaway inspection specs under the inspect dir (tests/e2e/inspect/**, deleted before hand-back), selector evidence under docs/evidence/selectors/** and a proposal note in the change's folder under docs/evidence/. Proposes; never edits the page repository, specs or fixtures.",
      "agentTypes": [
        "live-inspector"
      ],
      "codeImports": [
        "@playwright/test",
        "@civitas-cerebrum/element-interactions"
      ]
    },
    "doc-author": {
      "description": "Writes documentation only: docs/** (except the evidence trail docs/evidence/**), CLAUDE.md and project skills under .claude/skills/**. No shell, no dispatch, no authored code.",
      "agentTypes": [
        "doc-author"
      ]
    }
  },
  "stages": [
    {
      "id": "scaffold",
      "role": "orchestrator",
      "reads": [
        "tests/**",
        "docs/**",
        "package.json",
        "playwright.config.ts",
        ".gitignore",
        "README.md",
        ".achilles/**"
      ],
      "writes": [
        "tests/**",
        ".gitignore",
        ".achilles/**"
      ],
      "runs": [
        "npx playwright test --list",
        "git status",
        "git log",
        "git diff",
        "git add",
        "git commit"
      ],
      "network": [
        "localhost:4173",
        "localhost:3000"
      ],
      "dispatches": [
        "scaffolder"
      ],
      "skills": [
        "test-data-conventions"
      ]
    },
    {
      "id": "scaffold-suite",
      "role": "scaffolder",
      "reads": [
        "tests/e2e/**",
        "docs/**",
        "package.json",
        "playwright.config.ts",
        ".gitignore",
        "README.md"
      ],
      "writes": [
        "playwright.config.ts",
        "package.json",
        ".gitignore",
        "tests/e2e/.gitignore",
        "tests/e2e/playwright.setup.ts",
        "tests/e2e/fixtures/**",
        "tests/e2e/docs/app-context.md",
        "tests/e2e/page-repository.json"
      ],
      "skills": [
        "achilles-protocol"
      ]
    },
    {
      "id": "drive-pipeline",
      "role": "orchestrator",
      "reads": [
        "tests/**",
        "docs/**",
        ".achilles/**"
      ],
      "writes": [
        "tests/**",
        ".achilles/**",
        "docs/evidence/*/brief.md",
        "docs/evidence/*/review-package.md"
      ],
      "runs": [
        "npx playwright test",
        "npm test",
        "npm run test:repair",
        "npm run verify",
        "npm run change:start"
      ],
      "dispatches": [
        "scaffolder",
        "test-composer",
        "in-flight-composer",
        "workflow-reviewer",
        "phase-validator",
        "process-validator",
        "batch-reviewer",
        "perf-reviewer",
        "selector-diff-validator",
        "implementer",
        "task-reviewer",
        "verifier",
        "live-inspector",
        "doc-author"
      ],
      "network": [
        "localhost:4173",
        "localhost:3000"
      ],
      "skills": [
        "agents-vs-agents",
        "bug-discovery",
        "bug-report",
        "companion-mode",
        "ticket-driven-testing",
        "self-repair",
        "contract-testing",
        "contributing-to-achilles-protocol",
        "coverage-expansion",
        "database-testing",
        "achilles-protocol",
        "failure-diagnosis",
        "journey-mapping",
        "onboarding",
        "perf-onboarding",
        "performance-testing",
        "secrets-sweep",
        "selector-development",
        "test-catalogue",
        "test-composer",
        "test-repair",
        "work-summary-deck",
        "workflow-reviewer",
        "test-data-conventions"
      ]
    },
    {
      "id": "compose",
      "role": "test-composer",
      "reads": [
        "tests/**",
        "docs/**",
        "tests/e2e/page-repository.json"
      ],
      "writes": [
        "tests/e2e/**"
      ],
      "runs": [
        "npx playwright test"
      ],
      "network": [
        "localhost"
      ],
      "skills": [
        "test-composer",
        "achilles-protocol",
        "database-testing",
        "selector-development",
        "test-data-conventions"
      ]
    },
    {
      "id": "compose-in-flight",
      "role": "in-flight-composer",
      "reads": [
        "tests/**",
        "docs/**",
        "tests/e2e/page-repository.json"
      ],
      "writes": [
        "tests/e2e/**"
      ],
      "runs": [
        "npx playwright test"
      ],
      "network": [
        "localhost"
      ],
      "skills": [
        "test-composer",
        "achilles-protocol",
        "database-testing",
        "selector-development",
        "test-data-conventions"
      ]
    },
    {
      "id": "review-phase",
      "role": "workflow-reviewer",
      "reads": [
        "tests/**",
        "docs/**"
      ],
      "writes": [
        "tests/e2e/docs/onboarding-status.json"
      ],
      "skills": [
        "workflow-reviewer"
      ]
    },
    {
      "id": "validate-phase",
      "role": "phase-validator",
      "reads": [
        "tests/**",
        "docs/**"
      ],
      "writes": [
        "tests/e2e/docs/onboarding-status.json"
      ],
      "skills": [
        "workflow-reviewer"
      ]
    },
    {
      "id": "validate-process",
      "role": "process-validator",
      "reads": [
        "tests/**",
        "docs/**"
      ],
      "writes": [
        "tests/e2e/docs/onboarding-status.json"
      ],
      "skills": [
        "workflow-reviewer"
      ]
    },
    {
      "id": "review-batch",
      "role": "batch-reviewer",
      "reads": [
        "tests/**",
        "docs/**"
      ],
      "writes": [
        "tests/e2e/docs/onboarding-status.json"
      ],
      "skills": [
        "workflow-reviewer"
      ]
    },
    {
      "id": "review-perf",
      "role": "perf-reviewer",
      "reads": [
        "tests/perf/**",
        "docs/**"
      ],
      "writes": [
        "tests/perf/docs/perf-onboarding-status.json"
      ],
      "skills": [
        "workflow-reviewer"
      ]
    },
    {
      "id": "validate-selectors",
      "role": "selector-diff-validator",
      "reads": [
        "tests/**"
      ]
    },
    {
      "id": "implement",
      "role": "implementer",
      "reads": [
        "tests/**",
        "docs/**",
        "package.json",
        "playwright.config.ts"
      ],
      "writes": [
        "tests/**",
        "docs/evidence/*/report.md"
      ],
      "writesDeny": [
        "tests/e2e/page-repository.json",
        "tests/e2e/docs/onboarding-status.json"
      ],
      "runs": [
        "npx playwright test",
        "npx tsc --noEmit",
        "npm run test:unit"
      ],
      "network": [
        "localhost"
      ],
      "skills": [
        "achilles-protocol",
        "test-composer",
        "test-data-conventions",
        "contract-testing",
        "database-testing",
        "failure-diagnosis"
      ]
    },
    {
      "id": "review-task",
      "role": "task-reviewer",
      "reads": [
        "tests/**",
        "docs/**",
        "package.json",
        "playwright.config.ts"
      ],
      "writes": [
        "docs/evidence/*/review.md"
      ],
      "runs": [
        "npx tsc --noEmit",
        "npm run test:unit",
        "npm run test:hooks"
      ],
      "skills": [
        "workflow-reviewer",
        "achilles-protocol"
      ]
    },
    {
      "id": "verify-change",
      "role": "verifier",
      "reads": [
        "tests/**",
        "docs/**",
        "package.json",
        "playwright.config.ts"
      ],
      "writes": [
        "docs/evidence/*/verify.md"
      ],
      "runs": [
        "npx playwright test",
        "npx tsc --noEmit",
        "npm run test:unit",
        "npm run test:hooks"
      ],
      "env": [
        "SPEND_OPT_IN"
      ],
      "network": [
        "localhost"
      ],
      "skills": [
        "achilles-protocol",
        "failure-diagnosis",
        "test-data-conventions"
      ]
    },
    {
      "id": "inspect-live",
      "role": "live-inspector",
      "reads": [
        "tests/**",
        "docs/**",
        "tests/e2e/page-repository.json"
      ],
      "writes": [
        "tests/e2e/inspect/**",
        "docs/evidence/selectors/**",
        "docs/evidence/*/proposal-*.md"
      ],
      "runs": [
        "npx playwright test --config tests/e2e/inspect",
        "npx achilles-selector-evidence"
      ],
      "network": [
        "localhost"
      ],
      "skills": [
        "achilles-protocol"
      ]
    },
    {
      "id": "author-docs",
      "role": "doc-author",
      "reads": [
        "docs/**",
        "tests/**",
        "README.md",
        "CLAUDE.md",
        ".claude/skills/**"
      ],
      "writes": [
        "docs/**",
        "CLAUDE.md",
        ".claude/skills/**"
      ],
      "writesDeny": [
        "docs/evidence/**"
      ],
      "skills": [
        "achilles-protocol"
      ]
    }
  ]
}
